@charset "utf-8";

* { box-sizing: border-box; }

html, body, #root { height: 100%; margin: 0px; }

body { font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: radial-gradient(circle at center top, rgb(27, 16, 48) 0%, rgb(11, 7, 20) 60%, rgb(6, 4, 9) 100%); color: rgb(245, 243, 255); min-height: 100vh; }

.app { display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding: 32px 16px 60px; }

.app-title { font-size: 1.6rem; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; gap: 10px; }

.app-subtitle { color: rgb(182, 172, 214); font-size: 0.9rem; margin-bottom: 28px; }

.player-layout { display: flex; gap: 28px; width: 100%; max-width: 980px; flex-wrap: wrap; justify-content: center; }

.player-card { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 24px; padding: 28px; width: 340px; backdrop-filter: blur(10px); box-shadow: rgba(0, 0, 0, 0.45) 0px 20px 60px; flex-shrink: 0; }

.art { width: 100%; aspect-ratio: 1 / 1; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 4.5rem; margin-bottom: 20px; box-shadow: rgba(0, 0, 0, 0.5) 0px 12px 40px; transition: transform 0.4s; position: relative; overflow: hidden; }

.art::after { content: ""; position: absolute; inset: 0px; background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.25), transparent 60%); }

.art.playing { animation: 2.4s ease-in-out 0s infinite normal none running pulse; }

@keyframes pulse { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.track-info { text-align: center; margin-bottom: 18px; }

.track-title { font-size: 1.25rem; font-weight: 700; margin: 0px 0px 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.track-artist { color: rgb(182, 172, 214); margin: 0px; font-size: 0.95rem; }

.progress-row { display: flex; align-items: center; gap: 10px; font-size: 0.75rem; color: rgb(182, 172, 214); margin-bottom: 18px; }

input[type="range"] { appearance: none; flex: 1 1 0%; height: 5px; border-radius: 4px; background: linear-gradient(to right, #a06bff var(--progress, 0%), rgba(255,255,255,0.15) var(--progress, 0%)); outline: none; cursor: pointer; }

input[type="range"]::-webkit-slider-thumb { appearance: none; width: 13px; height: 13px; border-radius: 50%; background: rgb(255, 255, 255); box-shadow: rgba(160, 107, 255, 0.9) 0px 0px 8px; cursor: pointer; }

.controls { display: flex; align-items: center; justify-content: center; gap: 18px; margin-bottom: 20px; }

.control-btn { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(245, 243, 255); cursor: pointer; font-size: 1.3rem; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.2s, transform 0.15s; }

.control-btn:hover { background: rgba(255, 255, 255, 0.08); }

.control-btn:active { transform: scale(0.92); }

.control-btn.play { width: 60px; height: 60px; font-size: 1.6rem; background: linear-gradient(135deg, rgb(160, 107, 255), rgb(107, 139, 255)); box-shadow: rgba(120, 90, 255, 0.5) 0px 8px 24px; }

.control-btn.play:hover { background: linear-gradient(135deg, rgb(178, 132, 255), rgb(127, 160, 255)); }

.control-btn.active { color: rgb(178, 132, 255); }

.secondary-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }

.volume-row { display: flex; align-items: center; gap: 8px; flex: 1 1 0%; }

.volume-row input[type="range"] { max-width: 100px; }

.icon-btn { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(182, 172, 214); font-size: 1rem; cursor: pointer; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: background 0.2s, color 0.2s; }

.icon-btn:hover { background: rgba(255, 255, 255, 0.08); color: rgb(255, 255, 255); }

.icon-btn.active { color: rgb(255, 107, 157); }

.playlist-card { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 24px; padding: 20px; width: 420px; max-height: 560px; overflow-y: auto; backdrop-filter: blur(10px); box-shadow: rgba(0, 0, 0, 0.45) 0px 20px 60px; }

.playlist-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; padding: 0px 6px; }

.playlist-header h2 { font-size: 1rem; margin: 0px; letter-spacing: 0.3px; }

.playlist-header span { font-size: 0.75rem; color: rgb(143, 132, 179); }

.track-item { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 14px; cursor: pointer; transition: background 0.15s; }

.track-item:hover { background: rgba(255, 255, 255, 0.06); }

.track-item.active { background: rgba(160, 107, 255, 0.18); }

.track-item .mini-art { width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }

.track-item .mini-info { flex: 1 1 0%; min-width: 0px; }

.track-item .mini-title { font-size: 0.9rem; font-weight: 600; margin: 0px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgb(245, 243, 255); }

.track-item .mini-artist { font-size: 0.78rem; color: rgb(156, 146, 192); margin: 2px 0px 0px; }

.track-item .track-num { width: 22px; text-align: center; color: rgb(143, 132, 179); font-size: 0.85rem; }

.equalizer { display: flex; align-items: flex-end; gap: 2px; height: 14px; width: 22px; }

.equalizer span { flex: 1 1 0%; background: rgb(178, 132, 255); border-radius: 2px; animation: 1s ease-in-out 0s infinite normal none running eq; }

.equalizer span:nth-child(2) { animation-delay: 0.2s; }

.equalizer span:nth-child(3) { animation-delay: 0.4s; }

@keyframes eq { 
  0%, 100% { height: 30%; }
  50% { height: 100%; }
}

@media (max-width: 720px) {
  .playlist-card, .player-card { width: 100%; max-width: 400px; }
}
