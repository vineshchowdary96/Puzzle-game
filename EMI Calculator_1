@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: linear-gradient(135deg, rgb(238, 242, 255) 0%, rgb(247, 249, 252) 100%); color: rgb(31, 36, 48); min-height: 100vh; }

.app { max-width: 1000px; margin: 0px auto; padding: 32px 20px 60px; }

.header { text-align: center; margin-bottom: 28px; }

.header h1 { font-size: 2rem; margin: 0px 0px 6px; color: rgb(43, 47, 119); }

.header p { margin: 0px; color: rgb(102, 102, 102); }

.card { background: rgb(255, 255, 255); border-radius: 16px; box-shadow: rgba(43, 47, 119, 0.08) 0px 10px 30px; padding: 28px; }

.grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 32px; }

@media (max-width: 800px) {
  .grid { grid-template-columns: 1fr; }
}

.field { margin-bottom: 22px; }

.field-label { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; font-weight: 600; font-size: 0.95rem; }

.field-label .value { color: rgb(76, 79, 194); font-weight: 700; }

.field input[type="number"] { width: 100%; padding: 10px 12px; border: 1px solid rgb(217, 219, 233); border-radius: 8px; font-size: 1rem; outline: none; transition: border-color 0.15s; }

.field input[type="number"]:focus { border-color: rgb(99, 102, 241); }

input[type="range"] { width: 100%; margin-top: 6px; accent-color: rgb(99, 102, 241); }

.toggle-group { display: inline-flex; border: 1px solid rgb(217, 219, 233); border-radius: 8px; overflow: hidden; margin-left: 12px; }

.toggle-group button { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: rgb(255, 255, 255); padding: 4px 10px; cursor: pointer; font-size: 0.8rem; color: rgb(85, 85, 85); }

.toggle-group button.active { background: rgb(99, 102, 241); color: rgb(255, 255, 255); }

.results { background: linear-gradient(160deg, rgb(99, 102, 241), rgb(76, 79, 194)); border-radius: 16px; color: rgb(255, 255, 255); padding: 28px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }

.results .emi-amount { font-size: 2.4rem; font-weight: 800; margin: 6px 0px 20px; }

.results .emi-label { font-size: 0.9rem; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.06em; }

.donut-wrap { position: relative; width: 180px; height: 180px; margin: 10px 0px 20px; }

.donut-center { position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; }

.donut-center .pct { font-size: 1.1rem; font-weight: 700; }

.legend { width: 100%; display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }

.legend-row { display: flex; justify-content: space-between; align-items: center; background: rgba(255, 255, 255, 0.12); border-radius: 10px; padding: 10px 14px; font-size: 0.9rem; }

.legend-row .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 8px; }

.legend-row .left { display: flex; align-items: center; }

.legend-row .amt { font-weight: 700; }

.schedule-toggle { margin-top: 28px; text-align: center; }

.schedule-toggle button { background: rgb(99, 102, 241); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 10px 22px; border-radius: 8px; cursor: pointer; font-size: 0.95rem; font-weight: 600; }

.schedule-toggle button:hover { background: rgb(76, 79, 194); }

.schedule-wrap { margin-top: 20px; overflow-x: auto; max-height: 420px; border: 1px solid rgb(238, 238, 238); border-radius: 12px; }

table { width: 100%; border-collapse: collapse; font-size: 0.85rem; min-width: 560px; }

thead th { position: sticky; top: 0px; background: rgb(242, 242, 251); padding: 10px 12px; text-align: right; font-weight: 700; color: rgb(68, 68, 68); border-bottom: 1px solid rgb(229, 229, 240); }

thead th:first-child, tbody td:first-child { text-align: left; }

tbody td { padding: 8px 12px; text-align: right; border-bottom: 1px solid rgb(240, 240, 247); }

tbody tr:hover { background: rgb(248, 248, 255); }

.footer-note { text-align: center; color: rgb(136, 136, 136); font-size: 0.8rem; margin-top: 24px; }
