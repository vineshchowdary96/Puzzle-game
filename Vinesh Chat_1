@charset "utf-8";

* { box-sizing: border-box; }

html, body, #root { height: 100%; margin: 0px; }

body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: rgb(15, 17, 21); color: rgb(232, 232, 236); }

.app { display: flex; height: 100vh; width: 100vw; overflow: hidden; }

.sidebar { width: 300px; min-width: 240px; background: rgb(21, 23, 29); border-right: 1px solid rgb(35, 38, 46); display: flex; flex-direction: column; }

.sidebar-header { display: flex; align-items: center; gap: 12px; padding: 18px 16px; border-bottom: 1px solid rgb(35, 38, 46); }

.me-avatar { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: white; flex-shrink: 0; }

.me-name { font-weight: 600; font-size: 15px; }

.me-sub { font-size: 12px; color: rgb(154, 156, 165); }

.contact-list { overflow-y: auto; flex: 1 1 0%; }

.contact-item { display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 16px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: inherit; text-align: left; cursor: pointer; transition: background 0.15s; }

.contact-item:hover { background: rgb(28, 31, 39); }

.contact-item.active { background: rgb(34, 37, 47); border-left: 3px solid rgb(124, 92, 255); }

.avatar { position: relative; width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; flex-shrink: 0; }

.status-dot { position: absolute; bottom: -2px; right: -2px; width: 11px; height: 11px; border-radius: 50%; border: 2px solid rgb(21, 23, 29); }

.status-dot.online { background: rgb(34, 197, 94); }

.status-dot.away { background: rgb(245, 158, 11); }

.status-dot.offline { background: rgb(107, 114, 128); }

.contact-text { overflow: hidden; flex: 1 1 0%; }

.contact-name { font-weight: 600; font-size: 14px; }

.contact-preview { font-size: 12px; color: rgb(154, 156, 165); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.chat-panel { flex: 1 1 0%; display: flex; flex-direction: column; background: rgb(15, 17, 21); min-width: 0px; }

.chat-header { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid rgb(35, 38, 46); background: rgb(21, 23, 29); }

.chat-title { font-weight: 600; font-size: 15px; }

.chat-status { font-size: 12px; color: rgb(154, 156, 165); text-transform: capitalize; }

.messages { flex: 1 1 0%; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 10px; }

.bubble-row { display: flex; }

.bubble-row.me { justify-content: flex-end; }

.bubble-row.them { justify-content: flex-start; }

.bubble { max-width: 60%; padding: 10px 14px; border-radius: 16px; font-size: 14px; line-height: 1.4; position: relative; }

.bubble-row.me .bubble { background: rgb(124, 92, 255); color: white; border-bottom-right-radius: 4px; }

.bubble-row.them .bubble { background: rgb(31, 35, 44); color: rgb(232, 232, 236); border-bottom-left-radius: 4px; }

.bubble-time { font-size: 10px; opacity: 0.6; margin-top: 4px; text-align: right; }

.bubble.typing { display: flex; gap: 4px; align-items: center; padding: 12px 16px; }

.dot { width: 6px; height: 6px; border-radius: 50%; background: rgb(154, 156, 165); animation: 1.2s ease-in-out 0s infinite normal none running blink; }

.dot:nth-child(2) { animation-delay: 0.2s; }

.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink { 
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0px); }
  40% { opacity: 1; transform: translateY(-2px); }
}

.composer { display: flex; gap: 10px; padding: 16px 20px; border-top: 1px solid rgb(35, 38, 46); background: rgb(21, 23, 29); }

.composer input { flex: 1 1 0%; padding: 12px 16px; border-radius: 22px; border: 1px solid rgb(42, 45, 55); background: rgb(28, 31, 39); color: rgb(232, 232, 236); font-size: 14px; outline: none; }

.composer input:focus { border-color: rgb(124, 92, 255); }

.composer button { padding: 10px 20px; border-radius: 22px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: rgb(124, 92, 255); color: white; font-weight: 600; cursor: pointer; transition: opacity 0.15s; }

.composer button:disabled { opacity: 0.4; cursor: not-allowed; }

.composer button:not(:disabled):hover { background: rgb(106, 77, 224); }

@media (max-width: 700px) {
  .sidebar { width: 220px; }
  .bubble { max-width: 78%; }
}
